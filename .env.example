# Plantilla de variables del entorno. Copiar a `.env` y rellenar localmente.
# `.env` está ignorado por Git. NO escribir valores reales en este archivo:
# se versiona y es público. Los valores van vacíos a propósito.

# Alpaca: datos de mercado. Se leen en scripts/capturar_alpaca.py,
# scripts/historico_alpaca.py y experiments/exploracion-datos-gratis/.
# En GitHub Actions van como secretos cifrados, no como variables.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# LaTeX (el PDF final se copia a docs/QuantileFlow_propuesta_tecnica.pdf)
docs/propuesta/*.aux
docs/propuesta/*.log
